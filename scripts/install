#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

readonly binary_install_path="/host/opt/cni/bin/"

if [[ -w "${binary_install_path}" ]]; then
  cp /opt/cni/bin/wg-cni "${binary_install_path}/wg-cni"
fi

if [[ -z "${KUBERNETES_APISERVER_ENDPOINT}" ]]; then
  echo "environment variable KUBERNETES_APISERVER_ENDPOINT not set - aborting" >&2
  exit 1
fi

readonly kubeconfig_install_path="/host/etc/cni/net.d/wg-cni.kubeconfig"
readonly namespace="$(cat /var/run/secrets/kubernetes.io/serviceaccount/namespace)"

write_kubeconfig() {
  cat >"${kubeconfig_install_path}" <<EOF
apiVersion: v1
kind: Config
clusters:
- name: default-cluster
  cluster:
    certificate-authority-data: $(base64 </var/run/secrets/kubernetes.io/serviceaccount/ca.crt | tr -d '\r\n')
    server: ${KUBERNETES_APISERVER_ENDPOINT}
contexts:
- name: default-context
  context:
    cluster: default-cluster
    namespace: ${namespace}
    user: default-user
current-context: default-context
users:
- name: default-user
  user:
    token: $(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
EOF
  chmod 0600 "${kubeconfig_install_path}"
}

tokenhash=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token | sha512sum)
ca_certhash=$(base64 </var/run/secrets/kubernetes.io/serviceaccount/ca.crt | tr -d '\r\n' | sha512sum)

write_kubeconfig

while : ; do
  sleep 3400
  tokenhashnew=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token | sha512sum)
  ca_certhashnew=$(base64 </var/run/secrets/kubernetes.io/serviceaccount/ca.crt | tr -d '\r\n' | sha512sum)
  if test "$tokenhashnew" != "$tokenhash"; then
    echo "Token changed. Updating kubeconfig"
    tokenhash="$tokenhashnew"
    write_kubeconfig
  fi
  if test "$ca_certhashnew" != "$ca_certhash"; then
    echo "CA cert changed. Updating kubeconfig"
    ca_certhash="$ca_certhashnew"
    write_kubeconfig
  fi
done
